# Server configuration
PORT=3001
NODE_ENV=development

# Authentication
JWT_SECRET=feature-flag-system-secret-key-999

# Storage Configuration
# Toggle between 'memory' or 'postgres'
DB_TYPE=memory

# Cache / SSE Stream Event Bus Configuration
# Toggle between 'memory' or 'redis'
CACHE_TYPE=memory

# PostgreSQL Configuration (used when DB_TYPE=postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flagdb
# Alternative connection parameters if DATABASE_URL is not used:
# PGHOST=localhost
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=flagdb
# PGPORT=5432

# Redis Configuration (used when CACHE_TYPE=redis)
REDIS_URL=redis://localhost:6379
